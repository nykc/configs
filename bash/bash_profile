###############################################
# Bash configuration file
#
# Version: 2.0.1 | 2026-04-12
# Author: Derek Ackley
# File Location: ~/.bash_profile
#
###############################################

# ----- Prompt -----
parse_git_branch() {
  git branch 2>/dev/null | grep '*' | sed 's/* / /'
}

# ----- Prompt -----
export PS1="\[\033[0;37m\][\[\033[1;36m\]\t\[\033[0;37m\]] \[\033[1;35m\]\u\[\033[0;37m\]@\[\033[1;32m\]\h\[\033[1;33m\]:\w\[\033[0m\]\[\033[0;90m\]\$(parse_git_branch)\[\033[0m\] \$ "

# ----- Colors -----
export CLICOLOR=1
export LSCOLORS=gxBxhxDxfxhxhxhxhxcxcx
export TERM=xterm-256color

# ----- Grep Highlighting -----
export GREP_OPTIONS='--color=auto'

# ----- Silence macOS Bash Deprecation Warning -----
export BASH_SILENCE_DEPRECATION_WARNING=1

# ----- Aliases -----
if [ -f ~/.bash_aliases ]; then
  . ~/.bash_aliases
fi

# ----- Homebrew Completion -----
BREW_PREFIX="$(brew --prefix)"
if [ -f "$BREW_PREFIX/etc/bash_completion" ]; then
  . "$BREW_PREFIX/etc/bash_completion"
fi

###############################################
# PATH ORDER (CLEAN + DEDUPED)
# Priority:
#   1. Homebrew
#   2. PostgreSQL
#   3. pyenv
#   4. mise
#   5. Local user bin
###############################################

# Homebrew first
export PATH="/usr/local/bin:/usr/local/sbin:$PATH"

# PostgreSQL 16
export PATH="/usr/local/opt/postgresql@16/bin:$PATH"

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init --path)"
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"

# mise (runtime manager)
eval "$($HOME/.local/bin/mise activate bash)"

# Local user bin
export PATH="$HOME/.local/bin:$PATH"
